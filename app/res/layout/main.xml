<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/txt_aviso"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/vermelho"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- corpo do controle -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_corpo"
            android:paddingTop="24dp"
            android:paddingBottom="28dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <!-- ligar / entrada -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btn_power"
                    style="@style/Redondo"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_power"
                    android:contentDescription="Ligar e desligar" />

                <ImageButton
                    android:id="@+id/btn_source"
                    style="@style/Redondo"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/ic_source"
                    android:contentDescription="Entrada" />
            </RelativeLayout>

            <!-- direcional -->
            <FrameLayout
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_anel">

                <ImageButton
                    android:id="@+id/btn_up"
                    style="@style/Seta"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_up"
                    android:contentDescription="Cima" />

                <ImageButton
                    android:id="@+id/btn_down"
                    style="@style/Seta"
                    android:layout_gravity="bottom|center_horizontal"
                    android:src="@drawable/ic_down"
                    android:contentDescription="Baixo" />

                <ImageButton
                    android:id="@+id/btn_left"
                    style="@style/Seta"
                    android:layout_gravity="left|center_vertical"
                    android:src="@drawable/ic_left"
                    android:contentDescription="Esquerda" />

                <ImageButton
                    android:id="@+id/btn_right"
                    style="@style/Seta"
                    android:layout_gravity="right|center_vertical"
                    android:src="@drawable/ic_right"
                    android:contentDescription="Direita" />

                <TextView
                    android:id="@+id/btn_ok"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ok"
                    android:gravity="center"
                    android:clickable="true"
                    android:text="OK"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />
            </FrameLayout>

            <!-- voltar / inicio / play -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_back"
                    style="@style/Redondo"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Voltar" />

                <ImageButton
                    android:id="@+id/btn_home"
                    style="@style/Redondo"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Início" />

                <ImageButton
                    android:id="@+id/btn_play"
                    style="@style/Redondo"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Play e pausa" />
            </LinearLayout>

            <!-- volume / mudo e menu / foco -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_pilula">

                    <TextView
                        android:id="@+id/btn_vol_up"
                        style="@style/Gangorra"
                        android:text="+"
                        android:contentDescription="Aumentar volume" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="VOL"
                        android:textColor="@color/texto_fraco"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_vol_down"
                        style="@style/Gangorra"
                        android:text="−"
                        android:contentDescription="Diminuir volume" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_mute"
                        style="@style/Redondo"
                        android:src="@drawable/ic_mute"
                        android:contentDescription="Mudo" />

                    <ImageButton
                        android:id="@+id/btn_menu"
                        style="@style/Redondo"
                        android:layout_marginTop="22dp"
                        android:src="@drawable/ic_menu"
                        android:contentDescription="Menu" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_pilula">

                    <TextView
                        android:id="@+id/btn_foco_mais"
                        style="@style/Gangorra"
                        android:text="+"
                        android:contentDescription="Foco mais" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="FOCO"
                        android:textColor="@color/texto_fraco"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_foco_menos"
                        style="@style/Gangorra"
                        android:text="−"
                        android:contentDescription="Foco menos" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_ajustes"
            style="@style/Chip"
            android:layout_marginTop="18dp"
            android:text="@string/ajustes" />

        <!-- ajustes -->
        <LinearLayout
            android:id="@+id/painel_ajustes"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_corpo"
            android:padding="18dp"
            android:visibility="gone">

            <TextView style="@style/Titulo" android:text="@string/titulo_perfil" />
            <TextView style="@style/Ajuda" android:text="@string/ajuda_perfil" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btn_perfil_ant" style="@style/Chip" android:text="◀" />

                <TextView
                    android:id="@+id/txt_perfil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto"
                    android:textSize="14sp" />

                <TextView android:id="@+id/btn_perfil_prox" style="@style/Chip" android:text="▶" />
            </LinearLayout>

            <TextView
                style="@style/Titulo"
                android:layout_marginTop="22dp"
                android:text="@string/titulo_busca" />
            <TextView style="@style/Ajuda" android:text="@string/ajuda_busca" />

            <TextView
                android:id="@+id/txt_busca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView android:id="@+id/btn_busca_ant" style="@style/Chip" android:text="◀" />

                <TextView
                    android:id="@+id/btn_busca"
                    style="@style/Chip"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:minWidth="92dp"
                    android:text="@string/busca_iniciar" />

                <TextView android:id="@+id/btn_busca_prox" style="@style/Chip" android:text="▶" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_busca_repetir"
                style="@style/Chip"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/repetir" />

            <TextView
                style="@style/Ajuda"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/salvar_em" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btn_alvo_ant" style="@style/Chip" android:text="◀" />

                <TextView
                    android:id="@+id/txt_alvo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/btn_alvo_prox" style="@style/Chip" android:text="▶" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_salvar"
                style="@style/Chip"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_claro"
                android:text="@string/salvar" />

            <TextView
                android:id="@+id/txt_faltam"
                style="@style/Ajuda"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/btn_apagar"
                style="@style/Chip"
                android:layout_width="match_parent"
                android:textColor="@color/texto_fraco"
                android:text="@string/apagar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
